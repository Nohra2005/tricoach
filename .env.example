# intervals.icu (free): Settings > Developer Settings > API key, and your athlete ID (e.g. i123456)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
# Any passcode you choose. The app asks for it once per device.
APP_PASSCODE=

# Groq (free): console.groq.com > API Keys. GROQ_MODEL is optional, default openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=
