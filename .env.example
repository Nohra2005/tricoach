# intervals.icu: Settings > Developer Settings > API key, and your athlete ID (e.g. i123456)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
# Any passcode you choose. The app asks for it once per device.
APP_PASSCODE=
