# Account 1. intervals.icu (free): Settings > Developer Settings > API key, and athlete ID (e.g. i123456)
APP_PASSCODE=
APP_USER_NAME=
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Accounts 2 to 5 (optional): same four values with a USER<n>_ prefix. Passcodes must differ.
USER2_NAME=
USER2_PASSCODE=
USER2_INTERVALS_API_KEY=
USER2_INTERVALS_ATHLETE_ID=

# Groq (free): console.groq.com > API Keys. GROQ_MODEL is optional, default openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=

# Public demo: live AI sessions per day across all demo visitors (default 40). Each visitor
# also gets at most 5 a day; after that the demo shows a labelled sample session.
DEMO_DAILY_LIMIT=
