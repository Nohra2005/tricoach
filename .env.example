# Accounts 1 to 5, four values each with a USER<n>_ prefix. Passcodes must differ.
# intervals.icu (free): Settings > Developer Settings > API key, and athlete ID (e.g. i123456)
# (Account 1 also still accepts APP_PASSCODE, APP_USER_NAME, INTERVALS_API_KEY and
# INTERVALS_ATHLETE_ID, the names it had before accounts existed.)
USER1_NAME=
USER1_PASSCODE=
USER1_INTERVALS_API_KEY=
USER1_INTERVALS_ATHLETE_ID=

USER2_NAME=
USER2_PASSCODE=
USER2_INTERVALS_API_KEY=
USER2_INTERVALS_ATHLETE_ID=

# Groq (free): console.groq.com > API Keys. GROQ_MODEL is optional, default openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=

# Public demo: live AI sessions per day across all demo visitors (default 40). Each visitor
# also gets at most 5 a day; after that the demo shows a labelled sample session.
DEMO_DAILY_LIMIT=
