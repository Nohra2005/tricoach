// Cloudflare Worker for TriCoach: serves the app (dist/) and the /api routes (api/worker.ts).
// Secrets (passcodes, API keys) are set in the Cloudflare dashboard, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tricoach",
  "main": "api/worker.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto, node:async_hooks, and process.env filled from the Worker's variables
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tricoach",
      // The D1 database "tricoach" (Cloudflare dashboard > Storage & databases > D1).
      "database_id": "83181410-0fcc-41d2-ac82-f8d92a3e6f31"
    }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "tricoach-jobs" }],
    // One job at a time; a failed job is stored as failed, not retried.
    "consumers": [{ "queue": "tricoach-jobs", "max_batch_size": 1, "max_retries": 0 }]
  },
  // Variables added in the Cloudflare dashboard (names, athlete ids) are kept when this
  // file is deployed. Without this, each deploy would delete them.
  "keep_vars": true,
  "observability": { "enabled": true }
}
